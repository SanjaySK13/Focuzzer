{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focuzzer Rusted",
  "version": "0.1.0",
  "identifier": "com.focuzzer.rusted",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Focuzzer", "width": 1080, "height": 770, "minWidth": 690, "minHeight": 620, "center": true },
      { "label": "pill", "url": "index.html?pill", "title": "Focuzzer timer", "width": 196, "height": 54,
        "visible": false, "focus": false, "transparent": true, "decorations": false, "shadow": false,
        "alwaysOnTop": true, "skipTaskbar": true, "resizable": false },
      { "label": "alarm", "url": "index.html?alarm", "title": "Focuzzer distraction",
        "width": 580, "height": 176, "center": true, "visible": false, "focus": false,
        "focusable": false, "transparent": true, "decorations": false, "shadow": false,
        "alwaysOnTop": true, "skipTaskbar": true, "resizable": false },
      { "label": "quit", "url": "index.html?quit", "title": "Focuzzer quit challenge",
        "width": 480, "height": 370, "center": true, "visible": false,
        "backgroundColor": "#fcfaff",
        "alwaysOnTop": true, "skipTaskbar": true, "resizable": false },
      { "label": "reminder", "url": "index.html?reminder", "title": "Focuzzer study check-in",
        "width": 408, "height": 220, "center": true, "visible": false, "focus": false,
        "decorations": false, "shadow": false, "transparent": true,
        "alwaysOnTop": true, "skipTaskbar": true, "resizable": false }
    ],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
